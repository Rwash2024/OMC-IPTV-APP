{
  "name": "nova-iptv",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "mock": "node tools/mock-xtream.js",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "mock:api": "node tools/mock-omc-api.js",
    "dashboard": "npm --prefix dashboard run dev",
    "release:ota": "node tools/release.mjs ota",
    "release:apk": "node tools/release.mjs apk",
    "deploy:dashboard": "node tools/deploy-dashboard.mjs",
    "build:tv": "node tools/build-tv.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-updater": "^8.52.1",
    "hls.js": "^1.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/outfit": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@webos-tools/cli": "^3.2.6",
    "opentype.js": "^2.0.0",
    "vite": "^5.4.11"
  }
}
